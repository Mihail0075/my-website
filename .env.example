# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pratki

# Long random string used to sign login and kiosk cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me

# Public address of the site, used in QR codes and e-mails
APP_URL=http://localhost:3000

# Locker hardware: "simulated" (default) or "hardware" (Raspberry Pi controller polls /api/hw)
LOCKER_MODE=simulated

# E-mail (optional). Without SMTP_HOST, messages are only saved in the admin outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brza Pratka <no-reply@example.com>"
